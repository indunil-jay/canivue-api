# Application
APP_NAME="Canivue API"
APP_ENV="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# Database (Async SQLite default for local development, asyncpg for PostgreSQL in Docker/production)
DATABASE_URL="sqlite+aiosqlite:///./data/app.db"
# For Docker Postgres:
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@db:5432/canivue"
DB_ECHO=false

# PostgreSQL Container (docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=canivue
POSTGRES_PORT=5432

# Security & CORS
SECRET_KEY="change_me_in_production_super_secret_key"
ALLOWED_ORIGINS=["*"]
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# AI / ML
MODEL_REGISTRY_DIR="./model_registry"
USE_REAL_ML_MODELS=false

