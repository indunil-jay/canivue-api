# Application
APP_NAME="Canivue API"
APP_ENV="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# Database (Async SQLite default for local development, asyncpg for PostgreSQL in production)
DATABASE_URL="sqlite+aiosqlite:///./data/app.db"
DB_ECHO=false

# Security & CORS
SECRET_KEY="change_me_in_production_super_secret_key"
ALLOWED_ORIGINS=["*"]

# AI / ML
MODEL_REGISTRY_DIR="./model_registry"
# Per-model settings (e.g. <X>_MODEL_BACKEND, <X>_MODEL_WEIGHTS_PATH) get added here
# alongside each AI feature as it's built -- see .agents/skills/ml-feature/SKILL.md.
